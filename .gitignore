# ==============================================================================
# SmartQMS — Enterprise Git Ignore Policy
# ==============================================================================

# Environment & Secrets (NEVER commit real credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# Preserve environment examples
!.env.example

# Python & Virtual Environments
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
develop-eggs/
eggs/
parts/
var/
sdist/
installed.cfg
*.egg

# Testing & Quality Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js & Frontend Build Outputs
node_modules/
frontend/dist/
frontend/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
frontend/.vite/

# Local SQLite Databases (Preserve seeding scripts instead)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/smart_qms.db
backend/tests/test_smartqms.db

# Logs & Temporary Exports
logs/
*.log
tmp/
temp/
scratch/

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
