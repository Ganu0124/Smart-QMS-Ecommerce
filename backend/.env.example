# ==============================================================================
# SmartQMS Enterprise Suite Configuration (.env.example)
# Copy this file to .env in backend/ or root directory before starting the application.
# IMPORTANT: Replace all default secrets before deploying to staging/production!
# ==============================================================================

# Application Branding & Metadata
PROJECT_NAME="SmartQMS — E-Commerce Quality Management Suite"
TAGLINE="Software Quality. Verified at Every Stage."
VERSION="2.4.0"

# Workspace Mode
# Options: "standard" (seeds baseline governance records) or "clean" (admin only, empty database)
WORKSPACE_MODE="standard"

# Authentication & JWT Security
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./smart_qms.db"

# Storage & Uploads
UPLOAD_DIR="./uploads"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Production Initial Administrator (Used when initializing with --clean or WORKSPACE_MODE=clean)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@smartqms.io"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_PASSWORD="Admin@12345_ChangeMeInProd!"

# Development / Evaluation Baseline Credentials
SEED_ADMIN_EMAIL="admin@smartqms.io"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_QM_EMAIL="qamanager@smartqms.io"
SEED_QM_PASSWORD="Manager@12345"
SEED_DEV_EMAIL="developer@smartqms.io"
SEED_DEV_PASSWORD="Dev@12345"
SEED_TESTER_EMAIL="tester@smartqms.io"
SEED_TESTER_PASSWORD="Tester@12345"
SEED_REVIEWER_EMAIL="reviewer@smartqms.io"
SEED_REVIEWER_PASSWORD="Reviewer@12345"
